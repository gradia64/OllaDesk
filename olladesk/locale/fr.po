#, python-brace-format
msgid "errore HTTP {code} da GitHub"
msgstr "erreur HTTP {code} de GitHub"

#: olladesk/app_update.py:197
#, python-brace-format
msgid "GitHub non raggiungibile ({reason})"
msgstr "GitHub injoignable ({reason})"

#: olladesk/app_update.py:81
#, python-brace-format
msgid "Scarica olladesk_{version}_all.deb dalla pagina della release e installalo con: sudo apt install ./olladesk_{version}_all.deb"
msgstr "Téléchargez olladesk_{version}_all.deb depuis la page de la version et installez-le avec : sudo apt install ./olladesk_{version}_all.deb"

#: olladesk/app_update.py:86
msgid "Aggiorna dal pacchetto AUR «olladesk» con il tuo helper (es. yay -Syu olladesk) oppure ricostruiscilo con makepkg."
msgstr "Mettez à jour depuis le paquet AUR « olladesk » avec votre assistant (p. ex. yay -Syu olladesk) ou recompilez-le avec makepkg."

#: olladesk/app_update.py:93
#, python-brace-format
msgid "Scarica OllaDesk-{version}-{machine}.AppImage dalla pagina della release, rendilo eseguibile (chmod +x) e usalo al posto dell'AppImage attuale{where}."
msgstr "Téléchargez OllaDesk-{version}-{machine}.AppImage depuis la page de la version, rendez-le exécutable (chmod +x) et utilisez-le à la place de l'AppImage actuelle{where}."

#: olladesk/app_update.py:99
#, python-brace-format
msgid "Installa il bundle Flatpak della versione {version} con: flatpak install --user OllaDesk-{version}.flatpak (oppure flatpak update, se l'hai installato da un repository)."
msgstr "Installez le bundle Flatpak de la version {version} avec : flatpak install --user OllaDesk-{version}.flatpak (ou flatpak update, si vous l'avez installé depuis un dépôt)."

