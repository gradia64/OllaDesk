msgid "Aggiorna dal pacchetto AUR «olladesk» con il tuo helper (es. yay -Syu olladesk) oppure ricostruiscilo con makepkg."
msgstr "Aktualisieren Sie über das AUR-Paket „olladesk“ mit Ihrem Helfer (z. B. yay -Syu olladesk) oder bauen Sie es mit makepkg neu."

#: olladesk/app_update.py:92
#, python-brace-format
msgid "Scarica OllaDesk-{version}-{machine}.AppImage dalla pagina della release, rendilo eseguibile (chmod +x) e usalo al posto dell'AppImage attuale{where}."
msgstr "Laden Sie OllaDesk-{version}-{machine}.AppImage von der Release-Seite herunter, machen Sie es ausführbar (chmod +x) und verwenden Sie es anstelle des aktuellen AppImage{where}."

#: olladesk/app_update.py:97
msgid "Aggiorna il checkout: git pull, poi riavvia OllaDesk."
msgstr "Aktualisieren Sie den Checkout: git pull, dann OllaDesk neu starten."

#: olladesk/app_update.py:98
msgid "Aggiorna il pacchetto Python: pipx upgrade olladesk (oppure pip install -U)."
msgstr "Aktualisieren Sie das Python-Paket: pipx upgrade olladesk (oder pip install -U)."

