#: olladesk/app_update.py:104
msgid "Aggiorna il checkout: git pull, poi riavvia OllaDesk."
msgstr "Actualiza el repositorio: git pull y después reinicia OllaDesk."

#: olladesk/app_update.py:105
msgid "Aggiorna il pacchetto Python: pipx upgrade olladesk (oppure pip install -U)."
msgstr "Actualiza el paquete de Python: pipx upgrade olladesk (o pip install -U)."

#: olladesk/app_update.py:190
msgid "limite di richieste a GitHub raggiunto, riprova più tardi"
msgstr "límite de solicitudes a GitHub alcanzado, inténtalo más tarde"

#: olladesk/app_update.py:192
#, python-brace-format
msgid "errore HTTP {code} da GitHub"
msgstr "error HTTP {code} de GitHub"

#: olladesk/app_update.py:197
#, python-brace-format
msgid "GitHub non raggiungibile ({reason})"
msgstr "GitHub no accesible ({reason})"

#: olladesk/app_update.py:81
#, python-brace-format
msgid "Scarica olladesk_{version}_all.deb dalla pagina della release e installalo con: sudo apt install ./olladesk_{version}_all.deb"
msgstr "Descarga olladesk_{version}_all.deb desde la página de la versión e instálalo con: sudo apt install ./olladesk_{version}_all.deb"

#: olladesk/app_update.py:86
msgid "Aggiorna dal pacchetto AUR «olladesk» con il tuo helper (es. yay -Syu olladesk) oppure ricostruiscilo con makepkg."
msgstr "Actualiza desde el paquete AUR «olladesk» con tu asistente (p. ej. yay -Syu olladesk) o recompílalo con makepkg."

#: olladesk/app_update.py:93
#, python-brace-format
msgid "Scarica OllaDesk-{version}-{machine}.AppImage dalla pagina della release, rendilo eseguibile (chmod +x) e usalo al posto dell'AppImage attuale{where}."
msgstr "Descarga OllaDesk-{version}-{machine}.AppImage desde la página de la versión, hazlo ejecutable (chmod +x) y úsalo en lugar del AppImage actual{where}."

#: olladesk/app_update.py:99
#, python-brace-format
msgid "Installa il bundle Flatpak della versione {version} con: flatpak install --user OllaDesk-{version}.flatpak (oppure flatpak update, se l'hai installato da un repository)."
msgstr "Instala el bundle Flatpak de la versión {version} con: flatpak install --user OllaDesk-{version}.flatpak (o flatpak update, si lo instalaste desde un repositorio)."

